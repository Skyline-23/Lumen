<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <msi-file path="Lumen-*-Windows-x86_64.msi">
    <pe-file path="Lumen.exe">
      <authenticode-sign
        description="Lumen management app"
        description-url="https://github.com/Skyline-23/Lumen" />
    </pe-file>
    <pe-file path="LumenSessionAgent.exe">
      <authenticode-sign
        description="Lumen active-session agent"
        description-url="https://github.com/Skyline-23/Lumen" />
    </pe-file>
    <pe-file path="tools/LumenService.exe">
      <authenticode-sign
        description="Lumen host service"
        description-url="https://github.com/Skyline-23/Lumen" />
    </pe-file>
    <pe-file path="tools/LumenDriverSetup.exe">
      <authenticode-sign
        description="Lumen display driver setup"
        description-url="https://github.com/Skyline-23/Lumen" />
    </pe-file>
    <catalog-file path="driver/lumeniddcx.cat">
      <authenticode-sign />
    </catalog-file>
    <pe-file path="scripts/vigembus_installer.exe">
      <authenticode-verify />
    </pe-file>
    <authenticode-sign
      description="Lumen remote desktop host"
      description-url="https://github.com/Skyline-23/Lumen" />
  </msi-file>
</artifact-configuration>
