[Version]
Signature = "$WINDOWS NT$"
Class = Display
ClassGuid = {4d36e968-e325-11ce-bfc1-08002be10318}
Provider = %ProviderName%
CatalogFile = LumenIddCx.cat
DriverVer = 07/29/2026,0.1.0.6
PnpLockdown = 1

[DestinationDirs]
DriverCopy = 13

[SourceDisksNames]
1 = %DiskName%

[SourceDisksFiles]
LumenIddCx.dll = 1

[Manufacturer]
%ProviderName% = Models,NTamd64.10.0...17763

[Models.NTamd64.10.0...17763]
%DeviceDescription% = DriverInstall,Root\LumenIddCx

[DriverInstall.NT]
Include = WUDFRD.inf
Needs = WUDFRD.NT
CopyFiles = DriverCopy

[DriverInstall.NT.HW]
Include = WUDFRD.inf
Needs = WUDFRD.NT.HW
AddReg = DriverSecurity,DriverIsolation

[DriverCopy]
LumenIddCx.dll

[DriverSecurity]
HKR,,Security,,"D:P(A;;GA;;;SY)"

[DriverIsolation]
HKR,,"UpperFilters",0x00010000,"IndirectKmd"
HKR,"WUDF","DeviceGroupId",0x00000000,"LumenIddCx"

[DriverInstall.NT.Services]
Include = WUDFRD.inf
Needs = WUDFRD.NT.Services

[DriverInstall.NT.Wdf]
UmdfService = LumenIddCx,LumenIddCxService
UmdfServiceOrder = LumenIddCx
UmdfHostProcessSharing = ProcessSharingDisabled
UmdfKernelModeClientPolicy = AllowKernelModeClients

[LumenIddCxService]
UmdfLibraryVersion = 2.25.0
ServiceBinary = %13%\LumenIddCx.dll
UmdfExtensions = IddCx0102

[Strings]
ProviderName = "Lumen"
DeviceDescription = "Lumen Indirect Display Adapter"
DiskName = "Lumen Indirect Display Driver"
WUDFRdDisplayName = "Windows Driver Foundation - User-mode Driver Framework Reflector"
